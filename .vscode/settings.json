{
  "cSpell.words": [
    "sonner",
    "supabase"
  ],
  "i18n-ally.localesPaths": [
    "src/i18n",
    "src/messages",
    "src/components/i18n",
    "src/lib/i18n"
  ],
  "i18n-ally.keystyle": "nested",
  "task.allowAutomaticTasks": true,
  "debug.openDebug": "neverOpen",
  "terminal.integrated.inheritEnv": false,
  "tasks": {
    "label": "lint on open",
    "type": "shell",
    "command": "npm run lint",
    "runOn": "folderOpen"
  }
}
